# Chave que cifra o cookie de "Manter conectado". Obrigatória em produção para
# esse recurso funcionar; sem ela o site funciona, mas não mantém o login.
# Gere com:  openssl rand -base64 48
SESSAO_SEGREDO=

# Opcional: outro portal TOTVS RM e o nome exibido no site.
# PORTAL_URL=https://portal.catolicasc.org.br
# NEXT_PUBLIC_INSTITUICAO=Católica SC
